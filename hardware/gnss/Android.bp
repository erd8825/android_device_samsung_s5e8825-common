cc_binary {
    name: "android.hardware.gnss-service.samsung",
    relative_install_path: "hw",
    installable: false, // install APEX instead
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    defaults: [
        "gnss_use_latest_hal_aidl_ndk_shared",
    ],
    shared_libs: [
        "libbase",
        "libcutils",
        "libbinder_ndk",
        "libdl",
        "libcrypto",
        "libz",
        "libutils",
        "liblog",
    ],
    srcs: [
        "AGnssRil.cpp",
        "AGnss.cpp",
        "Gnss.cpp",
        "GnssBackend.cpp",
        "GnssDiagnostics.cpp",
        "GnssProtocol.cpp",
        "GnssSensors.cpp",
        "GnssAntennaInfo.cpp",
        "GnssAssistanceInterface.cpp",
        "GnssBatching.cpp",
        "GnssDebug.cpp",
        "GnssGeofence.cpp",
        "GnssNavigationMessageInterface.cpp",
        "GnssPowerIndication.cpp",
        "GnssPsds.cpp",
        "GnssConfiguration.cpp",
        "GnssMeasurementInterface.cpp",
        "GnssVisibilityControl.cpp",
        "MeasurementCorrectionsInterface.cpp",
        "service.cpp",
    ],
    header_libs: ["libandroid_sensor_headers"],
}

linker_config {
    name: "gnss-samsung-linker-config",
    src: "linker.config.json",
    installable: false,
}

prebuilt_etc {
    name: "gnss-samsung.rc",
    src: "gnss-samsung.rc",
    installable: false,
}

prebuilt_etc {
    name: "gnss-samsung.xml",
    src: "gnss-samsung.xml",
    sub_dir: "vintf",
    installable: false,
}

apex {
    name: "com.android.hardware.gnss.samsung",
    manifest: "apex_manifest.json",
    file_contexts: "apex_file_contexts",
    key: "com.android.hardware.key",
    certificate: ":com.android.hardware.certificate",
    updatable: false,
    vendor: true,
    required: ["libsensorndkbridge"],

    binaries: [
        "android.hardware.gnss-service.samsung",
    ],
    prebuilts: [
        "gnss-samsung-linker-config",
        "gnss-samsung.rc",
        "gnss-samsung.xml",
        "android.hardware.location.gps.prebuilt.xml", // permission
    ],
}
