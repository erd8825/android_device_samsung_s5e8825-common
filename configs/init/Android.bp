genrule {
    name: "gen_fstab_s5e8825.recovery",
    srcs: ["fstab.s5e8825.in"],
    cmd: `grep -Ev 'efs|product|keystorage|harx|system_|vbmeta|vendor' $(in) |
          sed -E 's/,?\w*mount,?|,fileencryption.*|recoveryonly,//g' |
          sed 's/,inlinecrypt/            /' |
          sed 's/recoveryonly/defaults/g' > $(out)`,
    out: ["recovery.fstab"],
}

genrule {
    name: "gen_fstab_s5e8825.vendor",
    srcs: ["fstab.s5e8825.in"],
    cmd: "grep -Ev ' first_stage_mount|recoveryonly' $(in) > $(out)",
    out: ["fstab.s5e8825"],
}

genrule {
    name: "gen_fstab_s5e8825.vendor_ramdisk",
    srcs: ["fstab.s5e8825.in"],
    cmd: "grep -E '#|first_stage_mount' $(in) > $(out)",
    out: ["fstab.s5e8825"],
}

prebuilt_etc {
    name: "fstab.s5e8825.vendor",
    src: ":gen_fstab_s5e8825.vendor",
    filename: "fstab.s5e8825",
    vendor: true,
}

prebuilt_etc {
    name: "init.s5e8825.rc",
    src: "init.s5e8825.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.s5e8825.usb.rc",
    src: "init.s5e8825.usb.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "init.s5e8825.recovery.rc",
    src: "init.s5e8825.recovery.rc",
    sub_dir: "init",
    recovery: true,
}

prebuilt_etc {
    name: "init.s5e8825.unify.rc",
    src: "init.s5e8825.unify.rc",
    sub_dir: "init",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.s5e8825.rc",
    src: "ueventd.s5e8825.rc",
    filename: "ueventd.rc",
    vendor: true,
}

prebuilt_root {
    name: "fstab.s5e8825.vendor_ramdisk",
    src: ":gen_fstab_s5e8825.vendor_ramdisk",
    filename: "fstab.s5e8825",
    vendor_ramdisk: true,
    install_in_root: true,
}
