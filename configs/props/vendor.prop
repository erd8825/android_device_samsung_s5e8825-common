# SPDX-License-Identifier: Apache-2.0
#

# Audio
aaudio.hw_burst_min_usec=2000
aaudio.mmap_exclusive_policy=2
aaudio.mmap_policy=2
af.fast_track_multiplier=1
audio.offload.min.duration.secs=30
audio.timecheck.timeout_duration_ms=10000

# Bluetooth
bluetooth.device.class_of_device=90,2,12
bluetooth.profile.a2dp.source.enabled=1
bluetooth.profile.asha.central.enabled=1
bluetooth.profile.avrcp.target.enabled=1
bluetooth.profile.bas.client.enabled=1
bluetooth.profile.gatt.enabled=1
bluetooth.profile.hfp.ag.enabled=1
bluetooth.profile.hid.device.enabled=1
bluetooth.profile.hid.host.enabled=1
bluetooth.profile.map.server.enabled=1
bluetooth.profile.opp.enabled=1
bluetooth.profile.pan.nap.enabled=1
bluetooth.profile.pan.panu.enabled=1
bluetooth.profile.pbap.server.enabled=1
bluetooth.profile.sap.server.enabled=1

# Codec2
media.c2.dmabuf.padding=512
debug.c2.use_dmabufheaps=1
debug.stagefright.c2inputsurface=-1
debug.stagefright.ccodec_delayed_params=1
media.c2.hal.selection=aidl
ro.vendor.gpu.dataspace=1

# Display
persist.sys.sf.color_saturation=1.0
persist.sys.sf.native_mode=0
ro.surface_flinger.enable_frame_rate_override=0
ro.surface_flinger.display_update_imminent_timeout_ms=50
ro.surface_flinger.has_HDR_display=1
ro.surface_flinger.has_wide_color_display=1
ro.surface_flinger.use_color_management=1

# Graphics
debug.renderengine.backend=skiavkthreaded
debug.sf.latch_unsignaled=1
debug.sf.layer_caching_active_layer_timeout_ms=1000
debug.sf.predict_hwc_composition_strategy=0
ro.hardware.egl=mali
ro.hardware.vulkan=mali
ro.opengles.version=196610
ro.surface_flinger.clear_slots_with_set_layer_buffer=1
ro.surface_flinger.enable_layer_caching=true
ro.surface_flinger.supports_background_blur=1
ro.vendor.ddk.set.afbc=1

# Power
vendor.powerhal.disp.idle_support=0

# RIL
ro.carrier=unknown
ro.radio.noril=no
vendor.rild.libpath=/vendor/lib64/libsec-ril.so
vendor.sec.rild.libpath=/vendor/lib64/libsec-ril.so

# Wi-Fi
ro.boot.wificountrycode=00
